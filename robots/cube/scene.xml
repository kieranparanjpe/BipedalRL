<mujoco model="cube_reach_scene">
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="cube_mat" rgba="0.8 0.2 0.2 1"/>
    <material name="goal_mat" rgba="0.2 0.8 0.2 0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <body name="cube" pos="0 0 0.05">
      <joint name="cube_x" type="slide" axis="1 0 0" range="-2 2" damping="1"/>
      <joint name="cube_y" type="slide" axis="0 1 0" range="-2 2" damping="1"/>
      <geom name="cube_geom" type="box" size="0.05 0.05 0.05" mass="1.0" material="cube_mat"/>
      <site name="cube_center" pos="0 0 0" size="0.015" rgba="1 1 1 1"/>
    </body>

    <site name="goal" pos="1 0 0.001" type="sphere" size="0.04" material="goal_mat"/>
  </worldbody>

  <actuator>
    <motor name="move_x" joint="cube_x" gear="1" ctrlrange="-1 1" ctrllimited="true"/>
    <motor name="move_y" joint="cube_y" gear="1" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
